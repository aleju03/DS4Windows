<Window x:Class="DS4WinWPF.DS4Forms.StickCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stick Circularity Calibration" Height="500" Width="600"
        Style="{DynamicResource WindowStyle}" Closed="Window_Closed"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12">
            <Run FontWeight="Bold">Calibrate Stick Edge:</Run>
            <Run>Click Start, then slowly rotate your joystick around its full physical edge. The boundary will be recorded. Click Stop when done, then Save to apply.</Run>
        </TextBlock>

        <!-- Visualization Canvas -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="#1A1A1A">
            <Canvas x:Name="visualizationCanvas" ClipToBounds="True">
                <!-- Perfect circle reference (light gray) -->
                <Ellipse x:Name="perfectCircle" Stroke="#444444" StrokeThickness="1" 
                         StrokeDashArray="4 2" />
                
                <!-- Recorded boundary (green polygon) -->
                <Polygon x:Name="boundaryPolygon" 
                         Stroke="#00AA00" StrokeThickness="2" 
                         Fill="#2200AA00" />
                
                <!-- Current stick position (red dot) -->
                <Ellipse x:Name="stickPositionDot" 
                         Width="12" Height="12" 
                         Fill="#FF4444" />
                
                <!-- Center crosshair -->
                <Line x:Name="centerLineH" Stroke="#444444" StrokeThickness="1"/>
                <Line x:Name="centerLineV" Stroke="#444444" StrokeThickness="1"/>
            </Canvas>
        </Border>

        <!-- Status and Stats -->
        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock x:Name="statusText" Text="Status: Ready" />
            <TextBlock x:Name="errorText" Text="Raw Boundary Error: --" Margin="0,4,0,0" />
            <TextBlock x:Name="correctedErrorText" Text="Estimated After Correction: --" Margin="0,2,0,0" Foreground="#88FF88" />
            <TextBlock x:Name="instructionText" Text="" Margin="0,4,0,0" Foreground="Orange" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="startBtn" Content="Start Recording" Click="StartBtn_Click" 
                    Width="120" Margin="0,0,8,0" />
            <Button x:Name="stopBtn" Content="Stop" Click="StopBtn_Click" 
                    Width="80" Margin="0,0,8,0" IsEnabled="False" />
            <Button x:Name="resetBtn" Content="Reset" Click="ResetBtn_Click" 
                    Width="80" Margin="0,0,8,0" />
            <Button x:Name="saveBtn" Content="Save" Click="SaveBtn_Click" 
                    Width="80" Margin="0,0,8,0" IsEnabled="False" />
            <Button x:Name="cancelBtn" Content="Cancel" Click="CancelBtn_Click" 
                    Width="80" />
        </StackPanel>
    </Grid>
</Window>
